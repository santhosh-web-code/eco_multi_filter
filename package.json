{
  "name": "ecom-multi-filter",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "install:all": "npm install --workspaces --include-workspace-root",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
